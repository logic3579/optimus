# Optimus local Dev defaults.
# Copy to .env only when overrides are needed. Never reuse the development
# secrets below in UAT or Production.

# === DEPLOYMENT IDENTITY AND IMAGES ===

# Change to optimus-uat or optimus-prod outside local development. Compose
# project names isolate networks and volumes on shared Docker hosts.
COMPOSE_PROJECT_NAME=optimus-dev

# Dev builds and tags local/*:dev images. For UAT/Prod, set IMAGE_REPOSITORY to
# ghcr.io/<owner> or docker.io/<namespace> and VERSION to an immutable CI or
# release tag.
IMAGE_REPOSITORY=local
VERSION=dev

# Bind loopback when an external TLS reverse proxy runs on the same host.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432

# === DEVELOPMENT-ONLY SECRETS ===

# 32+ byte JWT signing secret. Generate with: openssl rand -base64 48
OPTIMUS_JWT_SECRET=dev-only-jwt-secret-at-least-32-bytes

# P1 credentials-vault: 32-byte AES-256 master key, base64-encoded.
# Generate ONCE and store safely — losing it makes all encrypted credentials
# unrecoverable. Mint with one of:
#   cd optimus-be && go run ./cmd/vault-keygen
#   docker run --rm $(docker build -q -f deploy/be.Dockerfile \
#     --target vault-keygen .)
OPTIMUS_VAULT_MASTER_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Alternative to OPTIMUS_VAULT_MASTER_KEY: read the key from a file inside
# the BE container. Mount the file via the be service's volumes block.
# OPTIMUS_VAULT_MASTER_KEY_FILE=/etc/optimus/vault.key

# Postgres DSN. Hostname `postgres` matches the docker service name.
OPTIMUS_DATABASE_DSN=host=postgres port=5432 user=optimus password=optimus dbname=optimus sslmode=disable

# Postgres credentials (MUST align with values in OPTIMUS_DATABASE_DSN above)
POSTGRES_USER=optimus
POSTGRES_PASSWORD=optimus
POSTGRES_DB=optimus

# Database pool sizing and connection recycling.
OPTIMUS_DATABASE_MAX_OPEN_CONNS=25
OPTIMUS_DATABASE_MAX_IDLE_CONNS=5
OPTIMUS_DATABASE_CONN_MAX_LIFETIME=1h

# Session and authentication policy.
OPTIMUS_JWT_ACCESS_TTL=15m
OPTIMUS_JWT_REFRESH_TTL=168h
OPTIMUS_AUTH_BCRYPT_COST=10
OPTIMUS_AUTH_LOGIN_RATE_LIMIT_PER_IP=5
OPTIMUS_AUTH_LOGIN_RATE_LIMIT_PER_USERNAME=5
OPTIMUS_AUTH_LOGIN_RATE_LIMIT_WINDOW=1m
OPTIMUS_AUTH_LOGIN_RATE_LIMIT_BLOCK=1m

# Initial administrator identity. It is only used when the seed creates the
# administrator for the first time.
OPTIMUS_BOOTSTRAP_ADMIN_USERNAME=admin
OPTIMUS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# === RUNTIME SETTINGS (DEV DEFAULTS) ===

# CORS allowlist (comma-separated, no brackets/quotes). UAT/Prod must replace
# these local origins with their public HTTPS domain.
OPTIMUS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:8080
# Multiple origins: OPTIMUS_CORS_ALLOWED_ORIGINS=https://a.example.com,https://b.example.com

# Log level: debug | info | warn | error
OPTIMUS_LOG_LEVEL=debug
OPTIMUS_LOG_FORMAT=json

# Backend HTTP lifecycle timeouts. The internal listen address remains
# 0.0.0.0:8080 inside the Compose network.
OPTIMUS_SERVER_READ_TIMEOUT=15s
OPTIMUS_SERVER_WRITE_TIMEOUT=15s
OPTIMUS_SERVER_SHUTDOWN_TIMEOUT=20s

OPTIMUS_CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
OPTIMUS_CORS_ALLOW_CREDENTIALS=false
OPTIMUS_I18N_DEFAULT_LANG=zh-CN
OPTIMUS_I18N_SUPPORTED=zh-CN,en-US

# P4 assets discovery schedule (standard 5-field cron, evaluated in UTC).
OPTIMUS_ASSETS_SYNC_CRON=*/15 * * * *
# Delay scheduler startup so migrations and service initialization can settle.
OPTIMUS_ASSETS_SYNC_STARTUP_DELAY=30s
# Delete completed asset sync-run history older than this many days.
OPTIMUS_ASSETS_SYNC_RUN_RETENTION_DAYS=30
# Per-request timeout used when constructing AWS service clients.
OPTIMUS_ASSETS_AWS_REQUEST_TIMEOUT=30s

# P5 observability. Keep private ranges narrow; an empty value permits public
# Prometheus targets only. Comma-separate multiple CIDRs.
OPTIMUS_OBSERVABILITY_ALLOWED_PRIVATE_CIDRS=
OPTIMUS_OBSERVABILITY_QUERY_TIMEOUT=15s
OPTIMUS_OBSERVABILITY_MAX_BATCH_QUERIES=12
OPTIMUS_OBSERVABILITY_MAX_CONCURRENT=4
OPTIMUS_OBSERVABILITY_MAX_RANGE=168h
OPTIMUS_OBSERVABILITY_MIN_STEP=15s
OPTIMUS_OBSERVABILITY_MAX_POINTS_PER_SERIES=11000
OPTIMUS_OBSERVABILITY_MAX_SERIES=1000
OPTIMUS_OBSERVABILITY_MAX_RESPONSE_BYTES=16777216
OPTIMUS_OBSERVABILITY_MAX_ENRICHMENT_IPS=100

# P6 delivery worker, recovery, retention, and SSE limits.
OPTIMUS_DELIVERY_WORKER_CONCURRENCY=2
OPTIMUS_DELIVERY_LEASE_DURATION=30s
OPTIMUS_DELIVERY_LEASE_RENEW_INTERVAL=10s
OPTIMUS_DELIVERY_DEFAULT_STAGE_TIMEOUT=10m
OPTIMUS_DELIVERY_MAX_STAGE_TIMEOUT=30m
OPTIMUS_DELIVERY_RECONCILE_INTERVAL=15s
OPTIMUS_DELIVERY_EVENT_RETENTION_DAYS=30
OPTIMUS_DELIVERY_SSE_HEARTBEAT=20s
OPTIMUS_DELIVERY_SSE_MAX_CONNECTIONS=50

# === UAT / PRODUCTION REQUIRED OVERRIDES ===
# COMPOSE_PROJECT_NAME=optimus-uat              # or optimus-prod
# IMAGE_REPOSITORY=ghcr.io/<owner>              # or docker.io/<namespace>
# VERSION=<immutable-ci-or-release-tag>
# POSTGRES_PASSWORD=<unique-secret>
# OPTIMUS_DATABASE_DSN=host=postgres port=5432 user=optimus password=<same-secret> dbname=optimus sslmode=disable
# OPTIMUS_JWT_SECRET=<unique-32+-byte-secret>
# OPTIMUS_VAULT_MASTER_KEY=<unique-backed-up-base64-key>
# OPTIMUS_CORS_ALLOWED_ORIGINS=https://optimus-uat.example.com
# OPTIMUS_LOG_LEVEL=info
